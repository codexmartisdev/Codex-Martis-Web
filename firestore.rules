rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny everything not explicitly allowed.
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isOptionalStringWithin(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
             (data[field] is string && data[field].size() <= maxSize);
    }

    // Operator must be authenticated, use the exact operator email and have a verified email.
    function isOperator() {
      return isSignedIn() &&
        request.auth.token.email == 'codex.martis.dev@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Entity validators
    function isValidProject(data) {
      return data.keys().hasAll([
               'name', 'identifier', 'status', 'progress', 'createdAt', 'updatedAt'
             ]) &&
             isNonEmptyString(data.name, 200) &&
             isNonEmptyString(data.identifier, 100) &&
             isNonEmptyString(data.status, 50) &&
             data.progress is number && data.progress >= 0 && data.progress <= 100 &&
             isNonEmptyString(data.createdAt, 64) &&
             isNonEmptyString(data.updatedAt, 64) &&
             isOptionalStringWithin(data, 'description', 20000) &&
             isOptionalStringWithin(data, 'objective', 10000);
    }

    function isValidTask(data) {
      return data.keys().hasAll([
               'title', 'projectId', 'status', 'priority', 'createdAt', 'updatedAt'
             ]) &&
             isNonEmptyString(data.title, 300) &&
             isValidId(data.projectId) &&
             isNonEmptyString(data.status, 50) &&
             isNonEmptyString(data.priority, 50) &&
             isNonEmptyString(data.createdAt, 64) &&
             isNonEmptyString(data.updatedAt, 64) &&
             isOptionalStringWithin(data, 'description', 20000);
    }

    function isValidSession(data) {
      return data.keys().hasAll([
               'projectId', 'status', 'objective', 'startedAt'
             ]) &&
             isValidId(data.projectId) &&
             isNonEmptyString(data.status, 50) &&
             isNonEmptyString(data.objective, 5000) &&
             isNonEmptyString(data.startedAt, 64) &&
             isOptionalStringWithin(data, 'workDone', 20000) &&
             isOptionalStringWithin(data, 'testsDone', 20000) &&
             isOptionalStringWithin(data, 'decisionsTaken', 20000);
    }

    function isValidEnvironment(data) {
      return data.keys().hasAll([
               'name', 'projectId', 'service', 'account', 'status'
             ]) &&
             isNonEmptyString(data.name, 200) &&
             isValidId(data.projectId) &&
             isNonEmptyString(data.service, 200) &&
             isNonEmptyString(data.account, 320) &&
             isNonEmptyString(data.status, 100) &&
             isOptionalStringWithin(data, 'observations', 20000);
    }

    function isValidHistory(data) {
      return data.keys().hasAll([
               'title', 'category', 'timestamp'
             ]) &&
             isNonEmptyString(data.title, 300) &&
             isNonEmptyString(data.category, 100) &&
             isNonEmptyString(data.timestamp, 64) &&
             isOptionalStringWithin(data, 'description', 20000) &&
             isOptionalStringWithin(data, 'details', 20000);
    }

    function isValidProjectUpdate(data) {
      return data.keys().hasAll([
               'projectId', 'schemaVersion', 'createdAt', 'appliedAt'
             ]) &&
             isValidId(data.projectId) &&
             isNonEmptyString(data.schemaVersion, 50) &&
             isNonEmptyString(data.createdAt, 64) &&
             isNonEmptyString(data.appliedAt, 64) &&
             isOptionalStringWithin(data, 'summary', 20000) &&
             isOptionalStringWithin(data, 'originalJson', 250000) &&
             isOptionalStringWithin(data, 'rawJson', 250000);
    }

    // Projects collection: exclusive to authorized operator
    match /projects/{projectId} {
      allow get: if isOperator() && isValidId(projectId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOperator() && isValidId(projectId) && isValidProject(incoming());
      allow delete: if isOperator() && isValidId(projectId);
    }

    // Tasks collection: exclusive to authorized operator
    match /tasks/{taskId} {
      allow get: if isOperator() && isValidId(taskId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isOperator() && isValidId(taskId) && isValidTask(incoming());
      allow delete: if isOperator() && isValidId(taskId);
    }

    // Sessions collection: exclusive to authorized operator
    match /sessions/{sessionId} {
      allow get: if isOperator() && isValidId(sessionId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(sessionId) && isValidSession(incoming());
      allow update: if isOperator() && isValidId(sessionId) && isValidSession(incoming());
      allow delete: if isOperator() && isValidId(sessionId);
    }

    // Environments collection: exclusive to authorized operator
    match /environments/{environmentId} {
      allow get: if isOperator() && isValidId(environmentId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(environmentId) && isValidEnvironment(incoming());
      allow update: if isOperator() && isValidId(environmentId) && isValidEnvironment(incoming());
      allow delete: if isOperator() && isValidId(environmentId);
    }

    // History collection: exclusive to authorized operator
    match /history/{historyId} {
      allow get: if isOperator() && isValidId(historyId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(historyId) && isValidHistory(incoming());
      allow update: if isOperator() && isValidId(historyId) && isValidHistory(incoming());
      allow delete: if isOperator() && isValidId(historyId);
    }

    // Project Updates collection: exclusive to authorized operator
    match /projectUpdates/{updateId} {
      allow get: if isOperator() && isValidId(updateId);
      allow list: if isOperator();
      allow create: if isOperator() && isValidId(updateId) && isValidProjectUpdate(incoming());
      allow update: if isOperator() && isValidId(updateId) && isValidProjectUpdate(incoming());
      allow delete: if isOperator() && isValidId(updateId);
    }

    // Test connection doc: read-only, exclusive to authorized operator
    match /test/{docId} {
      allow get: if isOperator() && isValidId(docId);
    }
  }
}
